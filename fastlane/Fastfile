default_platform(:ios)

platform :ios do
  desc "Upload App Store screenshots only (6.7-inch, en-US)"
  lane :upload_screenshots do
    api_key = app_store_connect_api_key(
      key_id: "84T3YX7863",
      issuer_id: "6543b00f-d5a8-4e8c-8083-325449adaad0",
      key_filepath: File.expand_path("../AuthKey_84T3YX7863.p8", __dir__)
    )

    deliver(
      api_key: api_key,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      run_precheck_before_submit: false,
      force: true
    )
  end
end
