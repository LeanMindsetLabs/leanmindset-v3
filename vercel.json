{
  "buildCommand": "npx expo export -p web",
  "outputDirectory": "dist",
  "devCommand": "npx expo start --web",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    { "source": "/legal/:path*", "destination": "/legal/:path*" },
    { "source": "/(.*)", "destination": "/" }
  ]
}
